---
config:
  theme: neutral
  flowchart: { htmlLabels: true, padding: 10, nodeSpacing: 30, rankSpacing: 60 }
---
flowchart LR
    Laptop["Your laptop"] -- "ssh, then attach" --> Tmux
    subgraph Box["The box &mdash; on 24/7"]
        direction TB
        subgraph Tmux["tmux &mdash; holds the terminals"]
            direction TB
            T1["Terminal 1"]
            T2["Terminal 2"]
            T3["Terminal 3"]
        end
    end
    classDef local fill:#fdf2f2,stroke:#c0392b,stroke-width:2px
    class Laptop local
    style Box fill:#f7f8fc,stroke:#2e3192,stroke-width:2px
    style Tmux fill:#f0f9f0,stroke:#58c034,stroke-width:2px
