---
config:
  theme: neutral
  flowchart: { htmlLabels: true, padding: 12, nodeSpacing: 28, rankSpacing: 55 }
---
flowchart LR
    You(["You"]) --> SSH
    subgraph Laptop["Your laptop"]
        direction TB
        subgraph GB["Git Bash"]
            SSH["ssh"]
        end
    end
    SSH -- "attach" --> Session
    subgraph Box["The box &mdash; on 24/7"]
        direction TB
        subgraph Session["Your tmux session"]
            direction TB
            subgraph W0["Window 0"]
                subgraph CC["Claude Code"]
                    G["git"]
                end
            end
            W1["Window 1 &mdash; another project"]
            W2["Window 2 &mdash; a shell"]
        end
    end
    style Laptop fill:#fdf2f2,stroke:#c0392b,stroke-width:2px
    style GB fill:#ffffff,stroke:#c0392b
    style Box fill:#f7f8fc,stroke:#2e3192,stroke-width:2px
    style Session fill:#f0f9f0,stroke:#58c034,stroke-width:2px
    style W0 fill:#ffffff,stroke:#2e3192
    style CC fill:#eef0f9,stroke:#2e3192
    style G fill:#ffffff,stroke:#2e3192
